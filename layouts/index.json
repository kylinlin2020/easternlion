{{- $out := slice -}}
{{- range site.RegularPages -}}
  {{- $d := partial "series-summary.html" (dict "page" . "plain" true) -}}
  {{- if and (eq .Params.product_kind "alternator") -}}
    {{- $d = .Description | default (.Summary | plainify | truncate 140) -}}
  {{- end -}}
  {{- $cols := .Params.columns -}}
  {{- $iPrime := -1 }}{{ $iStandby := -1 }}{{ $i50 := -1 }}{{ $i60 := -1 }}
  {{- range $i, $c := $cols -}}
    {{- if eq $c "Prime power (kW)" }}{{ $iPrime = $i }}{{ end -}}
    {{- if eq $c "Standby power (kW)" }}{{ $iStandby = $i }}{{ end -}}
    {{- if eq $c "50Hz Output (kW)" }}{{ $i50 = $i }}{{ end -}}
    {{- if eq $c "60Hz Output (kW)" }}{{ $i60 = $i }}{{ end -}}
  {{- end -}}
  {{- /* every model with its power ratings: name, prime, standby, 50Hz, 60Hz */ -}}
  {{- $mm := slice -}}
  {{- range .Params.rows -}}
    {{- $name := index . 0 -}}
    {{- $prime := 0 }}{{ $standby := 0 }}{{ $o50 := 0 }}{{ $o60 := 0 }}
    {{- if ge $iPrime 0 -}}{{- with index . $iPrime -}}{{- if findRE "^[0-9]+(\\.[0-9]+)?" . -}}{{- $prime = int (float (replaceRE "[^0-9.].*$" "" .)) -}}{{- end -}}{{- end -}}{{- end -}}
    {{- if ge $iStandby 0 -}}{{- with index . $iStandby -}}{{- if findRE "^[0-9]+(\\.[0-9]+)?" . -}}{{- $standby = int (float (replaceRE "[^0-9.].*$" "" .)) -}}{{- end -}}{{- end -}}{{- end -}}
    {{- if ge $i50 0 -}}{{- with index . $i50 -}}{{- if findRE "^[0-9]+(\\.[0-9]+)?" . -}}{{- $o50 = int (float (replaceRE "[^0-9.].*$" "" .)) -}}{{- end -}}{{- end -}}{{- end -}}
    {{- if ge $i60 0 -}}{{- with index . $i60 -}}{{- if findRE "^[0-9]+(\\.[0-9]+)?" . -}}{{- $o60 = int (float (replaceRE "[^0-9.].*$" "" .)) -}}{{- end -}}{{- end -}}{{- end -}}
    {{- $cap := 0 -}}
    {{- if gt $standby 0 }}{{ $cap = $standby }}{{ else if gt $prime 0 }}{{ $cap = $prime }}{{ else if gt $o50 0 }}{{ $cap = $o50 }}{{ else if gt $o60 0 }}{{ $cap = $o60 }}{{ end -}}
    {{- if gt $cap 0 -}}
      {{- $mm = $mm | append (dict "n" $name "p" $prime "s" $standby "a" $o50 "b" $o60) -}}
    {{- end -}}
  {{- end -}}
  {{- $out = $out | append (dict
      "t" .Title
      "u" .RelPermalink
      "d" $d
      "k" (.Params.category | default "")
      "c" (.Parent.Title | default "")
      "g" (.Params.power_min | default 0)
      "p" (.Params.power_max | default 0)
      "h" (.Params.hz | default 0)
      "mm" $mm
  ) -}}
{{- end -}}

{{- /* category shortcuts for the search dropdown */ -}}
{{- $cats := slice -}}
{{- range site.Data.categories -}}
  {{- $cats = $cats | append (dict "t" (i18n .key) "u" .url "k" .key "d" (.description | default "")) -}}
{{- end -}}
{{- range site.Data.sidebar -}}
  {{- if not (in (slice "cat_brush_alternator" "cat_brushless_alternator" "cat_diesel_generator_set") .key) -}}
    {{- $cats = $cats | append (dict "t" (i18n .key) "u" .url "k" .key "d" "") -}}
  {{- end -}}
{{- end -}}

{{- dict "count" (len $out) "cats" $cats "items" $out | jsonify (dict "indent" "  ") -}}
